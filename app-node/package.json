{
  "name": "sf-dahlia-web-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DAHLIA Node/TS server - TanStack Start migration",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "start:worker": "node .output/server/worker.mjs",
    "heroku-postbuild": "npm run build && npm run db:generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:users": "tsx scripts/migrate-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@bloom-housing/ui-components": "^12.7.7",
    "@bloom-housing/ui-seeds": "^3.4.3",
    "@clerk/tanstack-react-start": "^0.14.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-router": "^1.120.14",
    "@tanstack/react-start": "^1.120.14",
    "autoprefixer": "^10.5.0",
    "bullmq": "^5.77.6",
    "ioredis": "^5.6.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.100.0",
    "tsx": "^4.22.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-cli": "^1.167.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "msw": "^2.14.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.1.0"
  }
}

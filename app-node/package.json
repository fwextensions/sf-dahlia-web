{
  "name": "sf-dahlia-web-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DAHLIA Node/TS server - TanStack Start migration",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node serve.mjs",
    "start:worker": "tsx src/worker.ts",
    "heroku-postbuild": "npm run build && npm run db:generate",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:full": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "migrate:users": "tsx scripts/migrate-users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@bloom-housing/ui-seeds": "^3.4.3",
    "@clerk/tanstack-react-start": "^0.14.0",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "autoprefixer": "^10.5.0",
    "bullmq": "^5.79.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.101.0",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-cli": "^1.167.17",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "msw": "^2.14.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
